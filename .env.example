# B&C Saúde - Variáveis de Ambiente de Produção (PostgreSQL)
NODE_ENV=production
PORT=3000

# String de Conexão com o PostgreSQL (Fornecida pelo Coolify ou Docker Compose)
DATABASE_URL="postgresql://bcsaude_user:bcsaude_secure_pass@postgres:5432/bcsaude?schema=public"

# URL Pública da Aplicação
NEXT_PUBLIC_APP_URL="https://bcsaude.com.br"
